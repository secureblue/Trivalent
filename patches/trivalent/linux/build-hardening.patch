---
diff --git a/build/config/compiler/BUILD.gn b/build/config/compiler/BUILD.gn
index ccfe9692ba..ceb8b959fe 100644
--- a/build/config/compiler/BUILD.gn
+++ b/build/config/compiler/BUILD.gn
@@ -465,12 +464,20 @@ config("compiler") {
       } else if (is_posix || is_fuchsia) {
         if (current_os != "aix") {
           # Not available on aix.
-          cflags += [ "-fstack-protector" ]
+          cflags += [ "-fstack-protector-strong" ]
+          rustflags += [ "-Zstack-protector=strong" ]
         }
       }
     }
   }

+  if (is_linux) {
+    cflags += [
+      "-fstack-clash-protection",
+      "-mharden-sls=all",
+    ]
+  }
+
   # Non-Apple Posix and Fuchsia compiler flags setup.
   # -----------------------------------
   if ((is_posix && !is_apple) || is_fuchsia) {
@@ -600,6 +608,12 @@ config("compiler") {
       cflags += [ "-fdiagnostics-print-source-range-info" ]
     }

+    cflags += [ "-ftrivial-auto-var-init=zero" ]
+
+    if (!is_ubsan && !is_ubsan_security) {
+      cflags += [ "-fwrapv" ]
+    }
+
     # Enable -fmerge-all-constants. This used to be the default in clang
     # for over a decade. It makes clang non-conforming, but is fairly safe
     # in practice and saves some binary size. We might want to consider
@@ -2161,7 +2175,7 @@ config("chromium_code") {
       # Non-chromium code is not guaranteed to compile cleanly with
       # _FORTIFY_SOURCE. Also, fortified build may fail when optimizations are
       # disabled, so only do that for Release build.
-      fortify_level = "2"
+      fortify_level = "3"

       # ChromeOS's toolchain supports a high-quality _FORTIFY_SOURCE=3
       # implementation with a few custom glibc patches. Use that if it's
@@ -3262,8 +3276,14 @@ buildflag_header("compiler_buildflags") {
 }

 config("cet_shadow_stack") {
-  if (enable_cet_shadow_stack && is_win) {
+  if (enable_cet_shadow_stack) {
     assert(target_cpu == "x64")
-    ldflags = [ "/CETCOMPAT" ]
+    if (is_win) {
+      ldflags = [ "/CETCOMPAT" ]
+    } else if (is_linux) {
+      cflags = [ "-fcf-protection=full" ]
+      ldflags = [ "-fcf-protection=full", "-Wl,-z,shstk" ]
+      rustflags = [ "-Zcf-protection=full" ]
+    }
   }
 }
diff --git a/build/config/linux/BUILD.gn b/build/config/linux/BUILD.gn
index e092782740..4f9b611186 100644
--- a/build/config/linux/BUILD.gn
+++ b/build/config/linux/BUILD.gn
@@ -18,12 +18,15 @@ config("compiler") {
     import("//build/config/arm.gni")
     cflags = []
     asmflags = []
+    rustflags = []
     if (arm_control_flow_integrity == "standard") {
-      cflags += [ "-mbranch-protection=standard" ]
-      asmflags += [ "-mbranch-protection=standard" ]
+      cflags += [ "-mbranch-protection=bti+pac-ret+leaf+gcs" ]
+      asmflags += [ "-mbranch-protection=bti+pac-ret+gcs" ]
+      rustflags += [ "-Zbranch-protection=bti,pac-ret,leaf,gcs" ]
     } else if (arm_control_flow_integrity == "pac") {
       cflags += [ "-mbranch-protection=pac-ret" ]
       asmflags += [ "-mbranch-protection=pac-ret" ]
+      rustflags += [ "-Zbranch-protection=pac-ret" ]
     }
   }
 }
